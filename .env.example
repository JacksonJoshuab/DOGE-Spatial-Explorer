# ─── DOGE Spatial Editor — Environment Configuration ──────────────────────────
# Copy this file to .env and fill in your values

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://doge:doge_secure_password@localhost:5432/doge_spatial

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
APPLE_TEAM_ID=your-apple-team-id
APPLE_CLIENT_ID=your-apple-client-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=./keys/apple-auth-key.p8
# Leave enabled in production: clients must request a server nonce before Apple or Microsoft sign-in.
REQUIRE_OIDC_NONCE=true

# Microsoft Entra ID / Microsoft Graph. Register the backend as a web/OIDC application.
MICROSOFT_TENANT_ID=your-entra-tenant-id
MICROSOFT_CLIENT_ID=your-entra-application-client-id
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Meta Quest / Horizon. Keep the app secret exclusively on the backend.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# META_TOKEN_DEBUG_URL=https://graph.facebook.com/debug_token

# ── Cloud Storage (S3 / MinIO) ───────────────────────────────────────────────
S3_BUCKET=doge-spatial-assets
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=doge_admin
S3_SECRET_KEY=doge_secure_password

# ── AI Services ───────────────────────────────────────────────────────────────
AI_SERVICE_URL=https://api.example.com/ai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=your-openai-responses-model
# Comma-separated server-approved model overrides; the default model is always allowed.
OPENAI_ALLOWED_MODELS=your-openai-responses-model

# NVIDIA NIM. For self-hosted NIM, use the HTTPS base URL of the deployment.
NIM_BASE_URL=https://your-nim-host.example.com
NIM_API_KEY=optional-nim-api-key
NIM_MODEL=your-nim-served-model
NIM_ALLOWED_MODELS=your-nim-served-model

# NVIDIA Jetson edge-device provisioning (32+ random bytes; never ship in a client app).
NVIDIA_JETSON_SHARED_SECRET=replace-with-a-provisioned-edge-secret

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_SIZE=100mb

# ── MinIO Console ─────────────────────────────────────────────────────────────
MINIO_ROOT_USER=doge_admin
MINIO_ROOT_PASSWORD=doge_secure_password

# ── Push Notifications ────────────────────────────────────────────────────────
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apns-team-id
APNS_BUNDLE_ID=com.doge.spatial-editor
FCM_SERVER_KEY=your-fcm-server-key
