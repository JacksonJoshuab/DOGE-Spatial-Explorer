{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endlessequator.example/schemas/release-evidence.schema.json",
  "title": "Endless Equator release evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product",
    "releaseCandidate",
    "sourceCommit",
    "decision",
    "generatedAt",
    "gates",
    "approvals"
  ],
  "properties": {
    "product": { "const": "Endless Equator Spatial Navigator" },
    "releaseCandidate": { "type": "string", "pattern": "^RC[0-9]+$" },
    "sourceCommit": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
    "decision": { "enum": ["NO_GO", "INTERNAL_TESTFLIGHT", "CONTROLLED_REHEARSAL", "OPERATIONAL_GO", "CONDITIONAL_GO"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": ["string", "null"], "format": "date-time" },
    "notes": { "type": "string", "maxLength": 4000 },
    "gates": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "mandatoryFor", "status", "owner", "checkedAt", "evidence"],
        "properties": {
          "id": { "enum": ["A", "B", "C", "D", "E", "F", "G", "H"] },
          "name": { "type": "string", "minLength": 3, "maxLength": 160 },
          "mandatoryFor": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["INTERNAL_TESTFLIGHT", "CONTROLLED_REHEARSAL", "OPERATIONAL_GO", "CONDITIONAL_GO"] }
          },
          "status": { "enum": ["NOT_STARTED", "IN_PROGRESS", "BLOCKED", "PASSED", "NOT_APPLICABLE", "EXPIRED"] },
          "owner": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "role", "organization", "contactEvidenceRef"],
            "properties": {
              "name": { "type": "string", "minLength": 2 },
              "role": { "type": "string", "minLength": 2 },
              "organization": { "type": "string", "minLength": 2 },
              "contactEvidenceRef": { "type": "string", "minLength": 3 }
            }
          },
          "checkedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": ["string", "null"], "format": "date-time" },
          "blockers": { "type": "array", "items": { "type": "string", "minLength": 3, "maxLength": 500 } },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "label", "scope", "result", "capturedAt", "sourceRef", "sha256", "containsSensitiveData"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-H]-[A-Z0-9_-]{3,80}$" },
                "kind": { "enum": ["BUILD_LOG", "ARCHIVE", "TEST_RESULT", "SCREENSHOT", "REPORT", "SIGNED_RECORD", "PERMIT", "CONTRACT", "QUOTE", "ROUTE_MANIFEST", "GPX", "DEPLOYMENT", "SECURITY_SCAN", "APP_STORE_RECORD", "OTHER"] },
                "label": { "type": "string", "minLength": 3, "maxLength": 300 },
                "scope": { "type": "string", "minLength": 3, "maxLength": 1000 },
                "result": { "enum": ["PASS", "FAIL", "INFORMATIONAL", "PENDING"] },
                "capturedAt": { "type": "string", "format": "date-time" },
                "validUntil": { "type": ["string", "null"], "format": "date-time" },
                "sourceRef": { "type": "string", "minLength": 3, "maxLength": 2000 },
                "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
                "containsSensitiveData": { "type": "boolean" },
                "redactedPublicSummaryRef": { "type": ["string", "null"], "maxLength": 2000 }
              }
            }
          }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "name", "decision", "signedAt", "evidenceRef"],
        "properties": {
          "role": { "enum": ["PRODUCT", "APPLE_RELEASE", "ACCESSIBILITY", "PRIVACY", "SECURITY", "PLATFORM_OPERATIONS", "EXPEDITION_OPERATIONS", "SAFETY", "ROUTE_VERIFIER", "GO_NO_GO_AUTHORITY"] },
          "name": { "type": "string", "minLength": 2 },
          "decision": { "enum": ["APPROVE", "APPROVE_WITH_CONDITIONS", "REJECT"] },
          "conditions": { "type": "array", "items": { "type": "string", "minLength": 3, "maxLength": 500 } },
          "signedAt": { "type": "string", "format": "date-time" },
          "evidenceRef": { "type": "string", "minLength": 3 }
        }
      }
    }
  }
}
