{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endless-equator.example/schemas/route-verification-manifest.schema.json",
  "title": "Endless Equator Route Verification Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "routeID", "gpxSHA256", "verifiedBy", "verifiedAt", "accessCheckedAt", "weatherCheckedAt", "validFrom", "validUntil", "segments", "bailouts", "emergencyPlan", "riderAcknowledgements", "signature"],
  "properties": {
    "manifestVersion": {"const": "1.0"},
    "routeID": {"type": "string", "minLength": 1},
    "gpxSHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verifiedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "organization", "role", "phone", "email"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "organization": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "phone": {"type": "string", "minLength": 5},
        "email": {"type": "string", "format": "email"}
      }
    },
    "verifiedAt": {"type": "string", "format": "date-time"},
    "accessCheckedAt": {"type": "string", "format": "date-time"},
    "weatherCheckedAt": {"type": "string", "format": "date-time"},
    "validFrom": {"type": "string", "format": "date-time"},
    "validUntil": {"type": "string", "format": "date-time"},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start", "end", "surface", "accessAuthority", "accessStatus", "source", "checkedAt"],
        "properties": {
          "id": {"type": "string"},
          "start": {"type": "string"},
          "end": {"type": "string"},
          "surface": {"type": "string"},
          "accessAuthority": {"type": "string"},
          "accessStatus": {"enum": ["open", "conditional", "closed"]},
          "source": {"type": "string"},
          "checkedAt": {"type": "string", "format": "date-time"},
          "conditions": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "bailouts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["segmentID", "description", "coordinate"], "properties": {"segmentID": {"type": "string"}, "description": {"type": "string"}, "coordinate": {"type": "object", "required": ["latitude", "longitude"], "properties": {"latitude": {"type": "number"}, "longitude": {"type": "number"}}}}},
    "emergencyPlan": {"type": "object", "required": ["lead", "primaryNumber", "medicalFacilities", "communications"], "properties": {"lead": {"type": "string"}, "primaryNumber": {"type": "string"}, "medicalFacilities": {"type": "array", "minItems": 1}, "communications": {"type": "array", "minItems": 1}}},
    "riderAcknowledgements": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["riderID", "acknowledgedAt"], "properties": {"riderID": {"type": "string"}, "acknowledgedAt": {"type": "string", "format": "date-time"}}}},
    "signature": {"type": "object", "required": ["algorithm", "keyID", "value"], "properties": {"algorithm": {"enum": ["Ed25519"]}, "keyID": {"type": "string"}, "value": {"type": "string", "contentEncoding": "base64"}}}
  }
}
